# ─────────────────────────────────────────────────────────────────────────────
# EcaAfrica Tablet Backend — Environment Configuration
#
# This file runs on the WINDOWS TABLET, not the server.
# The tablet bridges: FK623 device → this backend → EcaAfrica school server
# ─────────────────────────────────────────────────────────────────────────────

# Port this local backend listens on (tablet frontend calls localhost:5000)
PORT=5000

# ── School Server URL ────────────────────────────────────────────────────────
# Production server (use when deploying to real tablet):
SERVER_API_URL=https://backend.ecareafrica.net/api/v1

# Local development (use when testing on your laptop):
# SERVER_API_URL=http://192.168.1.75:5000/api/v1

# ── Tablet Identity ──────────────────────────────────────────────────────────
# After registering this tablet in the portal (Super Admin → Hardware → Tablets),
# copy the generated UUID and paste it here.
# Leave blank on first install — fill in after registration.
TABLET_UUID=

# ── WireGuard VPN ────────────────────────────────────────────────────────────
# These must match the school server's WireGuard configuration.
# The tablet wizard reads these values and pre-fills the setup form.

# Server public IP and WireGuard port (shown in wizard Step 3 as "Server Endpoint")
WG_SERVER_ENDPOINT=169.58.124.150:51820

# VPN subnet — must match server's wg0.conf and VPN_ALLOWED_IPS on the server.
# /16 supports 65534 tablets. Change only if your server uses a different subnet.
VPN_ALLOWED_IPS=10.0.0.0/16

# DNS server for the WireGuard tunnel
WG_DNS=1.1.1.1
