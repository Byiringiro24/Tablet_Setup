# ─────────────────────────────────────────────────────────────────────────────
# EcaAfrica Tablet Backend — Environment Configuration
#
# This file runs on the WINDOWS TABLET, not the server.
# The tablet acts as a bridge between:
#   FK623 biometric device  →  this Node.js backend  →  EcaAfrica school server
# ─────────────────────────────────────────────────────────────────────────────

# Port this local backend listens on.
# The tablet frontend (Next.js) calls http://localhost:5000
# The school server also calls this tablet on this port (via VPN or LAN)
PORT=5000

# ── School Server URL ────────────────────────────────────────────────────────
# The production EcaAfrica server. The tablet backend reports scans here.
# Switch between production and local testing by commenting/uncommenting:

# Production server (use this when deploying to real tablet):
SERVER_API_URL=https://backend.ecareafrica.net/api/v1

# Local development (use this when testing on your laptop):
# SERVER_API_URL=http://192.168.1.75:5000/api/v1

# ── Tablet Identity ──────────────────────────────────────────────────────────
# After you register this tablet in the EcaAfrica portal
# (Super Admin → Hardware → Tablets → Add Tablet),
# copy the generated UUID and paste it here.
# Leave blank on first install — fill in after registration.
TABLET_UUID=
