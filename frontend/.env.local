# ─────────────────────────────────────────────────────────────────────────────
# EcaAfrica Tablet Frontend — Environment Configuration
#
# This Next.js app runs ON THE TABLET and calls the local backend.
# NEXT_PUBLIC_API_URL always points to localhost:5000 on the tablet itself.
# Never change this to the school server URL — the frontend is local only.
# ─────────────────────────────────────────────────────────────────────────────

# Always localhost — this is the tablet's own Node.js backend (server.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
